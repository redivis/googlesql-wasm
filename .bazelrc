common --enable_bzlmod
common --verbose_failures
common --experimental_ui_max_stdouterr_bytes=-1

# The Emscripten toolchain is selected through toolchain resolution
build --incompatible_enable_cc_toolchain_resolution

# The bridge depends on googlesql targets that are only visible within googlesql; this is the alternative to patching
#   each BUILD file
build --check_visibility=false

# Compiling the generated parser (tm_parser.cc) takes several GB; with one emcc per core, a 16GB machine runs out
build --jobs=4
build --local_resources=memory=HOST_RAM*.75

# googlesql requires C++20
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --action_env=BAZEL_CXXOPTS="-std=c++20"

# Absolute include paths from the Emscripten sysroot otherwise fail Bazel's layering check
build --features=-layering_check
build --host_features=-layering_check
build --copt=-no-canonical-prefixes
build --host_copt=-no-canonical-prefixes

build --java_runtime_version=remotejdk_11

# scripts/bazel-build.sh collects the .proto files googlesql generates (parse_tree.proto, resolved_ast.proto, ...)
#   from bazel-out. They are intermediate outputs, which Bazel does not materialize from the disk cache by default
#   ("build without the bytes"), so a cached build would silently ship without them
build --remote_download_all

build --copt=-O3
build --copt=-DNDEBUG

# googlesql's own clang warning suppressions
build --cxxopt=-Wno-module-import-in-extern-c
build --cxxopt=-Wno-deprecated-declarations
build --cxxopt=-Wno-range-loop-analysis
build --cxxopt=-Wno-inconsistent-missing-override
build --cxxopt=-Wno-char-subscripts
build --cxxopt=-Wno-enum-compare-switch
build --cxxopt=-Wno-defaulted-function-deleted
build --cxxopt=-Wno-unused-private-field
build --cxxopt=-Wno-return-std-move
build --cxxopt=-Wno-reorder-ctor
build --cxxopt=-Wno-unused-const-variable
build --cxxopt=-Wno-unused-function
build --cxxopt=-Wno-macro-redefined
build --cxxopt=-Wno-sign-compare
